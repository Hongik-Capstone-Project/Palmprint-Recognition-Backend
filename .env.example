# ==================================
# 1. 데이터베이스 접속 설정 (Repository 구현 시 사용)
# ==================================
DB_HOST=localhost
DB_PORT= 3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ==================================
# 2. 보안 설정 (JWT 및 인증 핵심)
# ==================================
# JWT 토큰 서명에 사용되는 핵심 비밀 키입니다.
# 배포 시에는 반드시 openssl rand -hex 32 등으로 생성한 강력한 값으로 변경해야 합니다.
SECRET_KEY=put_your_secret_key_here
ALGORITHM=HS256 # JWT 서명 알고리즘
ACCESS_TOKEN_EXPIRE_MINUTES=30 # 토큰 만료 시간 (분 단위)

# ==================================
# 3. Redis 설정 (Issue #8 대비)
# ==================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================================
# 4. 서버 환경 설정
# ==================================
# local, development, production 중 하나
APP_ENV=local
DEBUG=True # True 또는 False

# ==================================
# 5. Mongo 설정 관련
# ==================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=password
MONGO_DB_NAME=palmprint_logs

EMBEDDING_SERVICE_URL=
PALM_SIMILARITY_THRESHOLD=0.85